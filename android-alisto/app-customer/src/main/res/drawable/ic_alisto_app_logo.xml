<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark Slate Background -->
    <path
        android:fillColor="#070A12"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Centered Alisto Customer Shield (Cyan/Blue + Amber Core) -->
    <group
        android:scaleX="0.80"
        android:scaleY="0.80"
        android:translateX="26"
        android:translateY="19.6">

        <!-- Outer Shield -->
        <path
            android:fillColor="#090D16"
            android:strokeWidth="3"
            android:strokeLineJoin="round"
            android:pathData="M35,2 L66,18 L58,68 L35,84 L12,68 L4,18 Z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="4"
                    android:startY="2"
                    android:endX="66"
                    android:endY="84"
                    android:startColor="#00F2FE"
                    android:endColor="#0284C7" />
            </aapt:attr>
        </path>

        <!-- Left Facet -->
        <path
            android:fillAlpha="0.95"
            android:pathData="M35,6 L35,80 L14,65 L6,20 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="6"
                    android:startY="6"
                    android:endX="35"
                    android:endY="80"
                    android:startColor="#0284C7"
                    android:endColor="#0369A1" />
            </aapt:attr>
        </path>

        <!-- Right Facet -->
        <path
            android:fillAlpha="0.95"
            android:pathData="M35,6 L64,20 L56,65 L35,80 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="6"
                    android:endX="64"
                    android:endY="80"
                    android:startColor="#38BDF8"
                    android:endColor="#0284C7" />
            </aapt:attr>
        </path>

        <!-- Amber Core Glow -->
        <path android:pathData="M35,44m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="35"
                    android:centerY="44"
                    android:gradientRadius="12"
                    android:startColor="#FFFBBF24"
                    android:centerColor="#BFF59E0B"
                    android:endColor="#00F59E0B" />
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FBBF24"
            android:pathData="M35,34 L41,46 L29,46 Z" />

        <!-- Central A Structure -->
        <path
            android:fillColor="#070A12"
            android:strokeColor="#00F2FE"
            android:strokeWidth="1.2"
            android:pathData="M35,12 L54,68 L46,68 L35,42 L24,68 L16,68 Z" />

        <!-- Node Crossbar -->
        <path
            android:strokeColor="#00F2FE"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M22,48 L48,48" />
        <path
            android:fillColor="#00F2FE"
            android:pathData="M22,48m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
        <path
            android:fillColor="#00F2FE"
            android:pathData="M48,48m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
    </group>
</vector>
