<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="400"
    android:viewportHeight="400">

    <!-- Deep Slate Backdrop -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M0,0h400v400h-400z" />

    <!-- Project Nexus Alisto Contractor Pro Mark (Amber Ripple + Inverted-A Pin) -->
    <group
        android:pivotX="200"
        android:pivotY="200"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <!-- Outer & Inner Amber Pulse Rings -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FBBF24"
            android:strokeWidth="8"
            android:strokeAlpha="0.34"
            android:pathData="M200,200m-155,0a155,155 0,1 1,310 0a155,155 0,1 1,-310 0" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FBBF24"
            android:strokeWidth="8"
            android:strokeAlpha="0.75"
            android:pathData="M200,200m-112,0a112,112 0,1 1,224 0a112,112 0,1 1,-224 0" />

        <!-- Subtle Cyan Pro Core Accent -->
        <path
            android:fillColor="#38BDF8"
            android:pathData="M200,140m-14,0a14,14 0,1 1,28 0a14,14 0,1 1,-28 0" />

        <!-- Inverted A / Map Pin Stroke -->
        <group android:translateY="-10">
            <path
                android:fillColor="#00000000"
                android:strokeColor="#F1F5F9"
                android:strokeWidth="30"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 100,100 L 300,100 L 200,320 Z M 150,180 L 250,180" />
        </group>
    </group>
</vector>
